# Copy this file to .env.local for local development.
# Find these values in Supabase: Project Settings > API.
# https://supabase.com/dashboard/project/_/settings/api
#
# Only use the publishable/anon key in this file. Never expose a service_role key.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Alternatively, use the legacy variable name below instead of the line above:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
